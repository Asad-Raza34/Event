{
  "name": "eventsphere",
  "version": "1.0.0",
  "private": true,
  "description": "EventSphere Management System — MERN expo & event management platform (admin, exhibitors, attendees)",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "seed:fresh": "npm --prefix backend run seed:fresh",
    "test": "npm --prefix backend test",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
