# ---------------------------------------------------------------------------
# EventSphere client environment (Vite). Only VITE_* variables reach the browser,
# so never place secrets here — the API keys live in server/.env only.
# ---------------------------------------------------------------------------

# Base URL of the API. Leave empty in development: the Vite dev server proxies
# /api, /uploads and /socket.io to the backend (see vite.config.js).
VITE_API_URL=

# Optional: where the dev server proxies API requests to.
VITE_API_PROXY=http://localhost:5000

# Public contact details shown in the footer.
VITE_SUPPORT_EMAIL=support@eventsphere.io
