# ---------------------------------------------------------------------------
# EventSphere API — environment configuration
# Copy to backend/.env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CLIENT_URL=http://localhost:5173

# Database. Local mongod, Docker, or MongoDB Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/eventsphere
# When the database above is unreachable in development, the API can boot an
# in-memory MongoDB so the project is runnable with zero setup. Never used in
# production. Set to false if you always want a hard failure instead.
ALLOW_IN_MEMORY_DB=true
# Auto-seed the in-memory database with demo data (dev convenience only).
SEED_ON_IN_MEMORY=true

# Authentication — ALWAYS replace these with long random strings.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=eventsphere

# Uploads (local disk). Path is relative to the server/ folder.
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Payments. provider=mock for the built-in demo gateway, provider=stripe to use
# Stripe Checkout (requires a secret key). Card data never touches this app.
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Event Assistant. provider=local answers from the application database with
# a rule-based NLU layer (no external calls, no key required).
# Set provider=openai|anthropic and provide a server-side key to use an LLM.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Password reset e-mail. If SMTP is not configured the API logs the reset link
# to the console (development) instead of sending mail.
MAIL_FROM=EventSphere <no-reply@eventsphere.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Expose password-reset tokens in API responses (development/demo only).
DEMO_MODE=true

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# Background scheduler (expo status transitions, session reminders)
SCHEDULER_ENABLED=true

ADMIN_INVITE_CODE=EventSphere2026-2027
